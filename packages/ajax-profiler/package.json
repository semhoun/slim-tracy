{
  "name": "@slim-tracy/ajax-profiler",
  "version": "1.0.0",
  "type": "module",
  "description": "Development-only Slim Tracy fetch/XHR profiler and optional Vue Devtools adapter",
  "engines": { "node": ">=22" },
  "exports": { ".": "./index.js", "./client": "./index.js", "./vue": "./vue.js" },
  "files": ["index.js", "client.js", "client.cjs", "vue.js"],
  "scripts": {
    "build": "node scripts/assets.mjs",
    "check:assets": "node scripts/assets.mjs --check",
    "test": "node --test && npm run check:assets"
  },
  "peerDependencies": { "@vue/devtools-api": ">=6.6.4 <7" },
  "peerDependenciesMeta": { "@vue/devtools-api": { "optional": true } },

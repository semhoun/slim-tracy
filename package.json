{
  "name": "runtracy",
  "version": "1.2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "version": "auto-changelog -p --commit-limit false && git add CHANGELOG.md",
    "check": "remark . --ignore-pattern 'vendor/**' --frail",
    "format": "remark . --ignore-pattern 'vendor/**' --quiet --frail --output",
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs",
    "test:js": "npm --prefix packages/ajax-profiler test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.28.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vue": "^3.5.24",
    "remark-cli": "^12.0.1",
    "remark-lint-list-item-indent": "^4.0.1",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1"
  },
  "overrides": {
    "remark-cli": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    }
  },
  "remarkConfig": {
    "plugins": [
      "remark-lint-list-item-indent",
      "remark-preset-lint-consistent",
      "remark-preset-lint-recommended"
    ]
  }
}

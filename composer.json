{
  "name": "semhoun/slim-tracy",
  "description": "Tracy for Slim4 Framework Debugger",
  "license": "Apache-2.0",
  "type": "library",
  "keywords": [
    "Slim Framework",
    "SlimTracy",
    "Tracy",
    "Debug bar",
    "Debugbar",
    "Debugger",
    "Eloquent ORM",
    "illuminate database",
    "PTY Terminal",
    "Profiler",
    "Slim4",
    "Slim 4",
    "Twig",
    "Doctrine DBAL"
  ],
  "authors": [
    {
      "name": "Konstantin Kaluzhnikov",
      "email": "k.kaluzhnikov@gmail.com",
      "homepage": "https://github.com/EvilKraft"
    },
    {
      "name": "Nathanael Semhoun",
      "email": "nathanael@semhoun.net",
      "homepage": "http://www.semhoun.net"
    }
  ],
  "require": {
    "php": ">=8.2 <8.6",
    "ext-mbstring": "*",
    "ext-json": "*",
    "tracy/tracy": ">=2.12.2 <2.12.3",
    "slim/slim": "^4.15.3"
  },
  "require-dev": {
    "php-di/php-di": "^7.0",
    "nyholm/psr7": "^1.8.2",
    "nunomaduro/phpinsights": "^2.13.3",
    "rector/rector": "^2.8.4",
    "phpunit/phpunit": "^11.5.57",
    "illuminate/database": "^12.70.2",
    "twig/twig": "^3.30.0",
    "slim/twig-view": "^3.4.1",
    "doctrine/orm": "^3.7.6"
  },
  "autoload": {
    "psr-4": {
      "SlimTracy\\": "src/SlimTracy"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@phpunit"
    ],
    "phpunit": "php vendor/bin/phpunit",
    "phpcs-check": "phpcs --standard=phpcs.xml",
    "rector-check": "rector process --dry-run",
    "rector-fix": "rector process",
    "insights-check": "phpinsights --config-path=./phpinsights.php",
    "insights-fix": "phpinsights --config-path=./phpinsights.php -- fix"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}

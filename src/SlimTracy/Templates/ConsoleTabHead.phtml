<?php

declare(strict_types=1);

return static function (array $view): string {
    ob_start();
?>

        <style type="text/css">
            .warn {
                display: none;
            }
            .warn_blink {
                color: ghostwhite !important;
                background: black !important;
            }
        </style>
        <script type="text/javascript">
            if (typeof jQuery === "function") {
                $(document).ready(function(){
                    // configure blinker
                    if(<?= $view['cfg']['ConsoleNoLogin'] ?>) {
                        function blinker() {
                            $(".warn_blink").fadeOut(800);
                            $(".warn_blink").fadeIn(800);
                        }
                        setInterval(blinker, 1600);
                    } else {
                        $( ".warn_blink" ).each(function () {
                        //    this.style.setProperty( "background", "transparent", "important" );
                            this.style.setProperty( "opacity", "0.2", "important" );
                        });
                    }
                });
            }
        </script><?php
    return (string) ob_get_clean();
};

<?php

declare(strict_types=1);

return static function (array $view): string {
    ob_start();
?><h1><?= $view['icon'] ?> Panel Selector</h1>
        <div class="tracy-inner">
            <table width="100%">
                <thead><tr><th>*Panels with asterisk are on by default</th></tr></thead>
                    <tr><th><input type="checkbox" onchange="toggleAllTracyPanels(this)" /> Toggle All</th></tr><?php
foreach (array_keys($view['defcfg']) as $name) {
    ?><tr><td style="padding-left: 20px">
            <input type="checkbox" name="selectedPanels[]" <?=
                ($view['cfg'][$name] ?? null) === 1 ? 'checked="checked"' : ''
            ?> value="<?= $name ?>" />&nbsp;<?= preg_replace('/[A-Z]{1,3}/', ' \0', str_replace('show', '', $name)) ?><?=
                $view['defcfg'][$name] === 1 ? '&nbsp;<strong>*</strong>' : ''
            ?>

            </td></tr><?php
}
?>

                <tfoot>
                    <tr>
                        <td style="text-align: center">
                            <input type="submit" onclick="changeTracyPanels('Enabled')" value="Set" />&nbsp; &nbsp;
                            <input type="submit" onclick="resetTracyPanels()" value="Reset" /><br />
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div><?php
    return (string) ob_get_clean();
};
